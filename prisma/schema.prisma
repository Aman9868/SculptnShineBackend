generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  firstName        String
  lastName         String
  refreshToken     String?
  role             Role         @default(USER)
  isCreatedByAdmin Boolean      @default(false)
  status           UserStatus   @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  auditLogs        AuditLog[]
  profile          UserProfile?
}

model UserProfile {
  id                    String                  @id @default(uuid())
  userId                String                  @unique
  profileImage          String?
  phone                 String?
  dateOfBirth           DateTime?
  gender                Gender?
  bio                   String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  webPushNotifications  Boolean                 @default(true)
  emailNotifications    Boolean                 @default(true)
  smsNotifications      Boolean                 @default(false)
  whatsappNotifications Boolean                 @default(false)
  skinType              String?
  workoutDaysPerWeek    Int?                    @default(3)
  addresses             Address[]
  cart                  Cart?
  couponUsages          CouponUsage[]
  integrations          ExternalIntegration[]
  notifications         Notification[]
  orders                Order[]
  reviews               ProductReview[]
  pushSubscriptions     PushSubscription[]
  replenishments        ReplenishmentSchedule[]
  supportTickets        SupportTicket[]
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlistItems         WishlistItem[]
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  userId    String?
  details   Json?
  createdAt DateTime @default(now())
  entityId  String?
  ipAddress String?
  status    String   @default("SUCCESS")
  userAgent String?
  userEmail String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, createdAt])
  @@index([action, createdAt])
  @@index([userId])
  @@index([createdAt])
}

model Address {
  id                   String      @id @default(uuid())
  userProfileId        String
  flatHouse            String
  areaStreet           String
  landmark             String?
  pincode              String
  townCity             String
  state                String
  deliveryInstructions String?
  isDefault            Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  userProfile          UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model ProductCategory {
  id            String               @id @default(uuid())
  name          String
  slug          String               @unique
  description   String?
  image         String?
  status        CategoryStatus       @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  banners       Banner[]
  products      Product[]
  subcategories ProductSubcategory[]
}

model ProductSubcategory {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String?
  image       String?
  status      CategoryStatus  @default(ACTIVE)
  categoryId  String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  banners     Banner[]
  products    Product[]
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model ProductBrand {
  id          String         @id @default(uuid())
  name        String         @unique
  slug        String         @unique
  logo        String?
  description String?
  website     String?
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  banners     Banner[]
  products    Product[]
}

model Product {
  id                 String                  @id @default(uuid())
  title              String
  slug               String                  @unique
  description        String?
  brandId            String?
  preference         Preference?             @default(NOT_APPLICABLE)
  unitPrice          Float
  discountPercentage Float?                  @default(0)
  gst                Float                   @default(18)
  expiryDate         DateTime?
  sku                String                  @unique
  stock              Int                     @default(0)
  lowStockAlert      Int                     @default(5)
  images             String[]
  videos             String[]                @default([])
  status             ProductStatus           @default(ACTIVE)
  categoryId         String?
  subcategoryId      String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  averageRating      Float                   @default(0)
  reviewCount        Int                     @default(0)
  banners            Banner[]
  cartItems          CartItem[]
  inventoryLogs      InventoryLog[]
  orderItems         OrderItem[]
  brand              ProductBrand?           @relation(fields: [brandId], references: [id])
  category           ProductCategory?        @relation(fields: [categoryId], references: [id])
  subcategory        ProductSubcategory?     @relation(fields: [subcategoryId], references: [id])
  reviews            ProductReview[]
  variants           ProductVariant[]
  replenishments     ReplenishmentSchedule[]
  supportTickets     SupportTicket[]
  wishlistItems      WishlistItem[]
}

model ProductVariant {
  id                 String                  @id @default(uuid())
  productId          String
  title              String
  sku                String                  @unique
  flavor             String?
  weight             String?
  unitPrice          Float
  discountPercentage Float?                  @default(0)
  gst                Float                   @default(18)
  expiryDate         DateTime?
  stock              Int                     @default(0)
  images             String[]                @default([])
  isDefault          Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  cartItems          CartItem[]
  orderItems         OrderItem[]
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  replenishments     ReplenishmentSchedule[]
}

model Cart {
  id            String      @id @default(uuid())
  userProfileId String      @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  items         CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model Order {
  id              String               @id @default(uuid())
  orderNumber     String               @unique
  userProfileId   String
  subTotalAmount  Float                @default(0)
  shippingAmount  Float                @default(0)
  totalAmount     Float
  status          OrderStatus          @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus        @default(PENDING)
  paymentMethod   PaymentProvider      @default(PHONEPE)
  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingPincode String
  trackingNumber  String?
  notes           String?
  invoiceUrl      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  couponCode      String?
  couponDiscount  Float                @default(0)
  couponId        String?
  couponUsages    CouponUsage[]
  coupon          Coupon?              @relation(fields: [couponId], references: [id])
  userProfile     UserProfile          @relation(fields: [userProfileId], references: [id])
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  supportTickets  SupportTicket[]
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  comment   String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  productId          String?
  variantId          String?
  productName        String
  productSku         String
  unitPrice          Float
  discountPercentage Float
  gst                Float
  quantity           Int
  createdAt          DateTime        @default(now())
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product?        @relation(fields: [productId], references: [id])
  variant            ProductVariant? @relation(fields: [variantId], references: [id])
}

model Payment {
  id                    String          @id @default(uuid())
  orderId               String
  merchantTransactionId String          @unique
  gatewayTransactionId  String?
  provider              PaymentProvider @default(PHONEPE)
  amount                Float
  status                PaymentStatus   @default(PENDING)
  responsePayload       Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model InventoryLog {
  id        String   @id @default(uuid())
  productId String
  change    Int
  type      String
  reason    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Banner {
  id            String              @id @default(uuid())
  title         String
  subtitle      String?
  image         String
  video         String?
  link          String?
  ctaText       String?
  type          BannerType          @default(HOME_GENERAL)
  targetType    BannerTargetType    @default(NONE)
  status        BannerStatus        @default(ACTIVE)
  sortOrder     Int                 @default(0)
  startDate     DateTime?
  endDate       DateTime?
  productId     String?
  categoryId    String?
  brandId       String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  mobileImage   String?
  subcategoryId String?
  brand         ProductBrand?       @relation(fields: [brandId], references: [id])
  category      ProductCategory?    @relation(fields: [categoryId], references: [id])
  product       Product?            @relation(fields: [productId], references: [id])
  subcategory   ProductSubcategory? @relation(fields: [subcategoryId], references: [id])
}

model WishlistItem {
  id            String      @id @default(uuid())
  userProfileId String
  productId     String
  createdAt     DateTime    @default(now())
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, productId])
}

model BusinessConfig {
  id           String   @id @default(uuid())
  brandName    String
  address      String
  gstNumber    String
  supportEmail String?
  supportPhone String?
  instagramUrl String?
  facebookUrl  String?
  youtubeUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmailConfig {
  id        String   @id @default(uuid())
  host      String
  port      Int
  secure    Boolean  @default(true)
  user      String
  password  String
  fromName  String?
  fromEmail String?
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Policy {
  id        String     @id @default(uuid())
  type      PolicyType @unique
  title     String
  content   String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ShippingRule {
  id        String   @id @default(uuid())
  name      String   @unique
  states    String[] @default([])
  charge    Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id            String          @id @default(uuid())
  ticketNumber  String          @unique
  userProfileId String
  orderId       String?
  productId     String?
  category      TicketCategory
  priority      TicketPriority  @default(MEDIUM)
  status        TicketStatus    @default(OPEN)
  subject       String
  description   String
  attachments   String[]        @default([])
  adminResponse String?
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order?          @relation(fields: [orderId], references: [id])
  product       Product?        @relation(fields: [productId], references: [id])
  userProfile   UserProfile     @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  messages      TicketMessage[]
}

model TicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  senderType  SenderType
  senderId    String
  message     String
  attachments String[]      @default([])
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id                 String       @id @default(uuid())
  productId          String
  userProfileId      String?
  rating             Int
  title              String?
  comment            String?
  images             String[]     @default([])
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(APPROVED)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userProfile        UserProfile? @relation(fields: [userProfileId], references: [id])
}

model SupportInfo {
  id             String   @id @default(uuid())
  type           String   @default("GENERAL")
  email          String?
  mobileNumber   String?
  whatsappNumber String?
  address        String?
  operatingHours String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Guide {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  category  String
  image     String
  videoUrl  String?
  content   String
  readTime  String
  status    Boolean  @default(true)
  author    String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id            String           @id @default(uuid())
  userProfileId String
  title         String
  message       String
  type          NotificationType @default(SYSTEM)
  link          String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  userProfile   UserProfile      @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id            String      @id @default(uuid())
  userProfileId String
  endpoint      String      @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime    @default(now())
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model Coupon {
  id                    String             @id @default(uuid())
  code                  String             @unique
  title                 String
  description           String?
  discountType          CouponDiscountType @default(PERCENTAGE)
  discountValue         Float
  maxDiscountAmount     Float?
  minOrderAmount        Float?             @default(0)
  scopeType             CouponScopeType    @default(GENERAL)
  applicableProductIds  String[]           @default([])
  applicableCategoryIds String[]           @default([])
  applicableBrandIds    String[]           @default([])
  startDate             DateTime           @default(now())
  endDate               DateTime
  usageLimit            Int?
  usageLimitPerUser     Int                @default(1)
  usedCount             Int                @default(0)
  isActive              Boolean            @default(true)
  isPublic              Boolean            @default(true)
  badgeText             String?
  bannerText            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  usages                CouponUsage[]
  orders                Order[]
}

model CouponUsage {
  id             String      @id @default(uuid())
  couponId       String
  userProfileId  String
  orderId        String?
  discountAmount Float
  createdAt      DateTime    @default(now())
  coupon         Coupon      @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order          Order?      @relation(fields: [orderId], references: [id])
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([couponId, userProfileId])
}

model ReplenishmentSchedule {
  id                  String          @id @default(uuid())
  userProfileId       String
  productId           String?
  variantId           String?
  orderId             String?
  servingsRemaining   Float
  estimatedRunOutDate DateTime
  lastNotifiedAt      DateTime?
  notificationStatus  String          @default("PENDING")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  product             Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  userProfile         UserProfile     @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model ExternalIntegration {
  id            String      @id @default(uuid())
  userProfileId String
  provider      String
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  isActive      Boolean     @default(true)
  lastSyncedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, provider])
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  PAID
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PHONEPE
  CASH_ON_DELIVERY
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum Preference {
  VEGETARIAN
  NON_VEGETARIAN
  EGGITARIAN
  VEGAN
  NOT_APPLICABLE
}

enum BannerType {
  HOME_GENERAL
  HOME_PRODUCT
  CATEGORY_HEADER
  BRAND_HEADER
  LOGIN_BG
  SIGNUP_BG
  PROMO
}

enum BannerTargetType {
  PRODUCT
  CATEGORY
  BRAND
  EXTERNAL_LINK
  NONE
  SUBCATEGORY
}

enum BannerStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
}

enum PolicyType {
  PRIVACY_POLICY
  TERMS_AND_CONDITIONS
  RETURN_POLICY
  SHIPPING_POLICY
  CANCELLATION_POLICY
  REFUND_POLICY
  COOKIE_POLICY
}

enum TicketCategory {
  DAMAGED_PRODUCT
  WRONG_ITEM
  DELIVERY_ISSUE
  PAYMENT_REFUND
  QUALITY_ISSUE
  GENERAL_INQUIRY
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SenderType {
  USER
  ADMIN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER_UPDATE
  PROMO
  SYSTEM
}

enum CouponDiscountType {
  PERCENTAGE
  FLAT
}

enum CouponScopeType {
  GENERAL
  FIRST_ORDER
  CATEGORY
  BRAND
  PRODUCT
  SEASONAL
}
